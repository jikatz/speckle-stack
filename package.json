{
  "name": "speckle-stack",
  "version": "0.1.0",
  "bin": {
    "speckle-stack": "bin/speckle-stack.js"
  },
  "scripts": {
    "clean": "rimraf cdk.out coverage",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:dev": "npm run clean && NAMESPACE=dev cdk deploy -v --app \"npx ts-node bin/speckle-stack.ts\" -e --require-approval never"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/node": "20.14.9",
    "aws-cdk": "2.154.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.3",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.525.0",
    "@types/aws-lambda": "^8.10.135",
    "aws-cdk-lib": "2.154.1",
    "config": "^3.3.12",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
